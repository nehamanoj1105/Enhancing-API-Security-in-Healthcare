ROLE_PERMISSIONS = {
    "doctor": ["prescribe", "view_vitals"],
    "nurse": ["view_vitals"],
    "pharmacist": ["dispense_medicine"],
    "administrator": ["manage_users"],
    "receptionist": ["schedule_appointments"],
    "patient": ["view_records"],
    "lab_technician": ["conduct_tests"],
}

from functools import wraps
from flask import jsonify, g

def require_role(required_permission):
    def decorator(f):
        @wraps(f)
        def decorated_function(*args, **kwargs):
            user_role = g.user["role"]
            if required_permission not in ROLE_PERMISSIONS.get(user_role, []):
                return jsonify({"message": "Access forbidden"}), 403
            return f(*args, **kwargs)
        return decorated_function
    return decorator
