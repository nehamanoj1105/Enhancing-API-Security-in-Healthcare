{
  "swagger": "2.0",
  "info": {
    "title": "Healthcare Anomaly Detection API",
    "description": "This API detects anomalies in healthcare login activities.",
    "version": "1.0.0"
  },
  "paths": {
    "/predict": {
      "post": {
        "summary": "Predict if the login is normal or anomalous",
        "parameters": [
          {
            "name": "login_time",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "login_time": {
                  "type": "number"
                },
                "failed_attempts": {
                  "type": "number"
                },
                "login_location": {
                  "type": "string"
                }
              },
              "required": ["login_time", "failed_attempts", "login_location"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully predicted",
            "examples": {
              "application/json": {
                "message": "Normal login"
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "examples": {
              "application/json": {
                "error": "Error message"
              }
            }
          }
        }
      }
    }
  }
}

